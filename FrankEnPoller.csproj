<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.1.1</Version>
    <AssemblyTitle>FrankEnPoller</AssemblyTitle>
    <Product>FrankEnPoller</Product>
    <Description>Tray monitor for an Enphase IQ Gateway and FranklinWH aGate. Unofficial; not affiliated with Enphase or FranklinWH.</Description>

    <!-- `dotnet publish -c Release -o publish` produces a single FrankEnPoller.exe
         (needs the .NET 8 Desktop Runtime, which is already installed here). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Debug symbols inside the exe, so error logs keep line numbers without a separate .pdb. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="*.prev.cs" />
  </ItemGroup>
</Project>
